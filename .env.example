# =============================================================================
# Legalite AI - Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# --- Application ---
APP_NAME=legalite-ai
APP_ENV=development            # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEBUG=true

# --- OpenAI ---
# OPENAI_API_KEY=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
OPTENAI_API_KEY=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
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# --- RAG tuning ---
RAG_TOP_K=6                       # legacy: used by the pure-vector retriever
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_MIN_CONFIDENCE_SCORE=0.35     # below this we refuse to answer

# --- Hybrid retrieval + rerank ---
HYBRID_TOPK_VECTOR=20             # top-k from Qdrant before fusion
HYBRID_TOPK_KEYWORD=20            # top-k from Postgres FTS before fusion
HYBRID_TOPK_FUSED=20              # top-k after RRF, fed into reranker
RAG_TOPK_FINAL=5                  # final top-k after rerank
RRF_K=60                          # constant in reciprocal rank fusion

# --- Reranker ---
RERANK_PROVIDER=cohere            # cohere | none
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0
RERANK_TIMEOUT_SECONDS=8

# --- Conversational memory ---
MEMORY_WINDOW_TURNS=6             # number of recent user/assistant turns kept
MEMORY_MAX_TOKENS=2000            # token cap when injecting memory

# --- Qdrant ---
QDRANT_URL=https://214bd220-49d8-4850-a741-e6a1bf869ea1.us-east-1-1.aws.cloud.qdrant.io
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6MGQ4NTQzNWEtZjUxYi00NjFiLWJkZTYtY2Q0MzMxYzIxNDA5In0.CLDVyx58TEJWREUpBSWiyaUd36-jitnWnmyEne4vHxk
QDRANT_COLLECTION=ghana_legal_docs

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=legalite
POSTGRES_PASSWORD=legalite_dev_password
POSTGRES_DB=legalite
# Full SQLAlchemy URL is built from the above; override here if you need to.
# DATABASE_URL=postgresql+psycopg://legalite:legalite_dev_password@postgres:5432/legalite

# --- Storage ---
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=50

# --- Phase 5: Case-law intelligence ---
CASE_LLM_ENRICHMENT_ENABLED=                # blank → auto (on iff real OPENAI key)
CASE_SIMILARITY_TOP_K=8
CASE_SIMILARITY_SEMANTIC_WEIGHT=0.65
CASE_SIMILARITY_TOPIC_WEIGHT=0.35
CITATION_RESOLUTION_THRESHOLD=0.6           # min confidence to auto-link an edge
CITATION_RESOLUTION_CHAIN_DEPTH=4

# --- Phase 5: Query planner ---
QUERY_PLANNER_LLM_FALLBACK_ENABLED=false    # heuristic-only when false (deterministic)
QUERY_PLANNER_MIN_HEURISTIC_CONFIDENCE=0.5

# --- Phase 5: Observability ---
PROMETHEUS_ENABLED=true
OTEL_ENABLED=false                          # set true + OTLP endpoint to ship traces
OTEL_SERVICE_NAME=legalite-ai
OTEL_EXPORTER_OTLP_ENDPOINT=                # e.g. http://otel-collector:4318/v1/traces

# --- Phase 5: Background ingestion (Arq + Redis) ---
REDIS_URL=redis://redis:6379/0
INGESTION_QUEUE_NAME=legalite_ingest
INGESTION_MAX_RETRIES=3
INGESTION_JOB_TIMEOUT_SECONDS=1800


#SUPABASE
SUPABASE_URL=https://bcwmafblbsysasjvsdev.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJjd21hZmJsYnN5c2FzanZzZGV2Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3OTg0ODQ1OCwiZXhwIjoyMDk1NDI0NDU4fQ.VjKgYRAUIpQCY4yGkzdsi_BjQ_strZ0J51fnQbipuik